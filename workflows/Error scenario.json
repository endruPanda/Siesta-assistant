    {
      "parameters": {},
      "id": "77d54072-e209-4bb1-82be-e3cef0018e92",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        32,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst wf = input.workflow || {};\nconst ex = input.execution || {};\nconst err = ex.error || input.trigger?.error || {};\n\nconst executionId = ex.id || 'N/A';\nconst errorMessage = String(err.message || 'Неизвестная ошибка').slice(0, 800);\nconst errorStack = String(err.stack || '').slice(0, 1500);\nconst lastNode = ex.lastNodeExecuted || err.node?.name || 'Неизвестный узел';\nconst executionUrl = ex.url || `ID: ${executionId}`;\nconst name = wf.name || 'Workflow';\n\n// не чиним сами себя\nif (wf.id && wf.id === $workflow.id) return [];\n\nconst msg = errorMessage.toLowerCase();\nlet category = 'fix';\nlet adminText = '';\n\nif (/(^|\\D)(429|502|503|504)(\\D|$)|rate.?limit|econnreset|etimedout|timed? ?out|socket hang up|overloaded/.test(msg)) {\n  category = 'notify';\n  adminText = `⏳ Временный сбой: ${name}\\nУзел: ${lastNode}\\nОшибка: ${errorMessage}\\n${executionUrl}`;\n} else if (/(^|\\D)(401|403)(\\D|$)|unauthori[sz]ed|forbidden|credential|invalid.{0,20}(api key|token)|quota exceeded|authorization failed/.test(msg)) {\n  category = 'notify';\n  adminText = `🚨 Проблема с доступом или ключами: ${name}\\nУзел: ${lastNode}\\nОшибка: ${errorMessage}\\n${executionUrl}`;\n}\n\nreturn [{ json: {\n  category, adminText,\n  workflowId: wf.id, workflowName: name,\n  executionId, lastNode, errorMessage, errorStack, executionUrl\n}}];"
      },
