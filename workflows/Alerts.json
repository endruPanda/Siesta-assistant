    {
      "parameters": {
        "jsCode": "const result = [];\n\n// Вспомогательная функция для форматирования даты и времени\nfunction formatDateTime(dateString) {\n  if (!dateString) return 'указанное время';\n  try {\n    const date = new Date(dateString);\n    const day = date.getDate();\n    const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];\n    const month = months[date.getMonth()];\n    const hours = String(date.getHours()).padStart(2, '0');\n    const minutes = String(date.getMinutes()).padStart(2, '0');\n    return `${day} ${month} в ${hours}:${minutes}`;\n  } catch (e) {\n    return dateString;\n  }\n}\n\n// Вспомогательная функция парсинга\nfunction processEvent(item, type) {\n  const event = item.json;\n  const description = event.description || '';\n  const summary = event.summary || '';\n\n  let platform = null;\n  let userId = null;\n\n  // Ищем ID мессенджера\n  const tgMatch = description.match(/tg(?:_id)?:?\\s*(\\d+)/i) || summary.match(/tg(?:_id)?:?\\s*(\\d+)/i);\n  const vkMatch = description.match(/vk(?:_id)?:?\\s*(\\d+)/i) || summary.match(/vk(?:_id)?:?\\s*(\\d+)/i);\n\n  if (vkMatch) {\n    platform = 'vk';\n    userId = vkMatch[1];\n  } else if (tgMatch) {\n    platform = 'telegram';\n    userId = tgMatch[1];\n  }\n\n  if (!userId) return null;\n\n  // Время для текста\n  const rawTime = event.start?.dateTime || event.start?.date;\n  const formattedTime = formatDateTime(rawTime);\n  \n  // Очищаем название услуги от технических тегов (чтобы не писать \"маникюр tg 12345\")\n  const cleanService = summary.replace(/(tg|vk)(?:_id)?:?\\s*\\d+/gi, '').trim() || 'процедуру';\n\n  // ГЕНЕРАЦИЯ ТЕКСТА СООБЩЕНИЯ\n  let messageText = '';\n  if (type === 'reminder') {\n    messageText = `Здравствуйте! Это Сиеста, ваш виртуальный администратор. 🌸\\n\\nНапоминаю, что у вас запись на услугу «${cleanService}».\\nЖдём вас ${formattedTime}!\\n\\nЕсли ваши планы изменятся, пожалуйста, предупредите нас заранее.`;\n  } else if (type === 'survey') {\n    messageText = `Здравствуйте! Это снова администратор Сиеста. ✨\\n\\nВы недавно были у нас на услуге «${cleanService}». Будем очень благодарны за обратную связь!\\n\\nВсё ли вам понравилось? Может быть, у вас есть пожелания или то, что хотелось бы изменить? Ваш отзыв поможет нам стать лучше!`;\n  }\n\n  return {\n    json: {\n      type: type,\n      platform: platform,\n      userId: userId,\n      eventTitle: cleanService,\n      startTime: rawTime,\n      formattedTime: formattedTime,\n      messageText: messageText, // <-- Теперь текст будет передаваться дальше\n      eventId: event.id\n    }\n  };\n}\n\n// 1. Безопасно забираем данные из нод (даже если они пустые)\nlet reminders = [];\nlet surveys = [];\n\ntry { \n  reminders = $('Напоминание').all(); \n} catch(e) { }\n\ntry { \n  surveys = $('Опрос').all(); \n} catch(e) { }\n\n// 2. Обрабатываем напоминания\nfor (const item of reminders) {\n  if (item.json && item.json.id) {\n    const processed = processEvent(item, 'reminder');\n    if (processed) result.push(processed);\n  }\n}\n\n// 3. Обрабатываем опросы\nfor (const item of surveys) {\n  if (item.json && item.json.id) {\n    const processed = processEvent(item, 'survey');\n    if (processed) result.push(processed);\n  }\n}\n\nreturn result;"
      },
